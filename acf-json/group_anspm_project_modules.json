                            "conditional_logic": [
                                [
                                    {
                                        "field": "field_anspm_news_link_label",
                                        "operator": "!=empty"
                                    }
                                ]
                            ]
                        },
                        {
                            "key": "field_anspm_news_background",
                            "label": "Background",
                            "name": "background",
                            "type": "select",
                            "choices": {
                                "cream": "Cream (#f5f1e8)",
                                "white": "White",
                                "navy": "Navy (reversed text)"
                            },
                            "default_value": "cream",

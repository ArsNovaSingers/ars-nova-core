                                "3": "Three",
                                "4": "Four"
                            },
                            "default_value": "3",
                            "ui": 0,
                            "instructions": "Desktop only. Always two across on tablet and one on phones."
                        },
                        {
                            "key": "field_anspm_news_excerpt_words",
                            "label": "Excerpt length (words)",
                            "name": "excerpt_words",
                            "type": "number",
                            "default_value": 22,
                            "min": 0,
                            "max": 100,
                            "instructions": "Set to 0 for titles only."
